# AMI agentic demos — environment configuration.
# Copy to .env and adjust. Every variable is optional; defaults shown.

# --- Mode switches (two independent labels) ---------------------------------
# agent: "live"  = Ollama drives tool selection via the bounded loop
#        "scripted" = deterministic tool plan (rehearsal; no model calls)
# data:  "live"    = the Pattern1 Graph AutoRAG service answers retrieval
#        "fixture" = canned service-contract responses from fixtures/
AMI_AGENT_MODE=live
AMI_DATA_MODE=live

# --- Pattern1 service (Maritime demo backend)
AMI_GRAPH_PATTERN_CONFIG=http://localhost:8010

# --- Local model serving (Ollama, OpenAI-compatible endpoint) ---------------
AMI_MODEL_ENDPOINT=http://localhost:11434/v1
AMI_MODEL_ID=ami-demo3-qwen
AMI_MODEL_API_KEY=ollama

# --- Agent budget ------------------------------------------------------------
AMI_MAX_TOOL_CALLS=6
AMI_TOOL_TIMEOUT_SECONDS=45
AMI_REQUEST_TIMEOUT_SECONDS=180

# --- Exercise defaults --------------------------------------------------------
AMI_ANALYSIS_CUTOFF=2026-11-17T12:00:00Z
AMI_ASSET_ROOT=assets
